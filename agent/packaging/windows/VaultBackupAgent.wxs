<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX source for VaultBackup Agent MSI (Windows x64).
  Installs per-machine with elevated privileges and a LocalSystem service.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <?ifndef LicenseRtf ?>
    <?define LicenseRtf = "License.rtf" ?>
  <?endif?>
  <Product
      Id="*"
      Name="VaultBackup Agent"
      Language="1033"
      Version="$(var.Version)"
      Manufacturer="VaultBackup"
      UpgradeCode="B7E4C2A1-9F3D-4E8B-A1C6-2D5E7F90B3A4">

    <Package
        Compressed="yes"
        InstallScope="perMachine"
        InstallPrivileges="elevated"
        Platform="x64"
        Description="VaultBackup desktop backup agent"
        Comments="Encrypted database backups to your storage. Requires administrator to install." />

    <MajorUpgrade
        DowngradeErrorMessage="A newer version of VaultBackup Agent is already installed."
        Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AgentIcon" SourceFile="icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AgentIcon" />
    <Property Id="ARPHELPLINK" Value="https://backup.enadoctemp.workers.dev/" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Property Id="WEBUIPASSWORD" Secure="yes" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <Condition Message="VaultBackup Agent requires 64-bit Windows.">
      <![CDATA[VersionNT64]]>
    </Condition>

    <Feature Id="ProductFeature" Title="VaultBackup Agent" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="AgentEnvConfig" />
      <ComponentRef Id="ProgramDataDir" />
    </Feature>

    <UIRef Id="WixUI_InstallDir" />
    <UIRef Id="WixUI_ErrorProgressText" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="VaultBackup Agent" />
      </Directory>
      <Directory Id="CommonAppDataFolder">
        <Directory Id="VendorDataFolder" Name="VaultBackup">
          <Directory Id="AgentDataFolder" Name="Agent" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="VaultBackup Agent" />
      </Directory>
    </Directory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="*" Win64="yes">
        <File Id="AgentExe"
              Source="vaultbackup-agent-windows-amd64.exe"
              Name="vaultbackup-agent.exe"
              KeyPath="yes"
              Checksum="yes" />
        <ServiceInstall
            Id="VaultBackupAgentService"
            Type="ownProcess"
            Name="VaultBackupAgent"
            DisplayName="VaultBackup Agent"
            Description="VaultBackup Agent - scheduled encrypted database backups (Local System)."
            Start="auto"
            Account="LocalSystem"
            ErrorControl="normal"
            Interactive="no"
            Vital="yes"
            Arguments='-config "[AgentDataFolder]config.json" -webui 127.0.0.1:8787' />
        <ServiceControl
            Id="StartService"
            Name="VaultBackupAgent"
            Start="install"
            Stop="both"
            Remove="uninstall"
            Wait="yes" />
      </Component>
      <Component Id="DefaultConfig" Guid="*" Win64="yes">
        <File Id="ConfigExample"
              Source="config.example.json"
              Name="config.example.json"
              KeyPath="yes" />
      </Component>
      <Component Id="ReadmeFile" Guid="*" Win64="yes">
        <File Id="Readme"
              Source="README-WINDOWS.txt"
              Name="README.txt"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <DirectoryRef Id="AgentDataFolder">
      <Component Id="ProgramDataDir" Guid="*" Win64="yes">
        <CreateFolder>
          <Permission User="Administrators" GenericAll="yes" />
          <Permission User="SYSTEM" GenericAll="yes" />
          <Permission User="Users" Read="yes" GenericExecute="yes" />
        </CreateFolder>
        <RegistryValue Root="HKLM"
                       Key="Software\VaultBackup\Agent"
                       Name="DataPath"
                       Type="string"
                       Value="[AgentDataFolder]"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="*" Win64="yes">
        <Shortcut Id="StartMenuShortcut"
                  Name="VaultBackup Agent UI"
                  Description="Open local agent setup UI (service must be running)"
                  Target="[System64Folder]cmd.exe"
                  Arguments="/c start http://127.0.0.1:8787"
                  WorkingDirectory="INSTALLFOLDER" />
        <Shortcut Id="StartMenuService"
                  Name="Start VaultBackup Agent Service"
                  Description="Start the agent Windows service (requires admin)"
                  Target="[System64Folder]net.exe"
                  Arguments="start VaultBackupAgent"
                  WorkingDirectory="INSTALLFOLDER" />
        <Shortcut Id="UninstallProduct"
                  Name="Uninstall VaultBackup Agent"
                  Target="[System64Folder]msiexec.exe"
                  Arguments="/x [ProductCode]" />
        <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKLM"
                       Key="Software\VaultBackup\Agent"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="AgentEnvConfig" Guid="*" Win64="yes">
        <RegistryValue Root="HKLM"
                       Key="Software\VaultBackup\Agent"
                       Name="InstallPath"
                       Type="string"
                       Value="[INSTALLFOLDER]"
                       KeyPath="yes" />
        <RegistryValue Root="HKLM"
                       Key="Software\VaultBackup\Agent"
                       Name="Version"
                       Type="string"
                       Value="$(var.Version)" />
      </Component>
    </DirectoryRef>

    <CustomAction Id="SeedConfig"
                  Directory="INSTALLFOLDER"
                  ExeCommand='cmd /c if not exist "[AgentDataFolder]config.json" copy /Y "[INSTALLFOLDER]config.example.json" "[AgentDataFolder]config.json"'
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="SeedConfig" Before="StartServices">NOT REMOVE</Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
